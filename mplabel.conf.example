# /etc/mplabel.conf   (chmod 600, owned by the user the service runs as)
#
# Tuned for a CLABEL G4 (Shenzhen Dudian), 203 dpi, USB.
#
# Any value can be overridden by an environment variable named
# MPLABEL_<KEY>, e.g. MPLABEL_IMAP_PASSWORD. That is the better place for
# the password if you would rather not have it on disk.

[mplabel]
imap_host       = imap.gmail.com
imap_port       = 993
imap_user       = her-address@gmail.com

# Gmail App Password, NOT the account password. Generate one at
# myaccount.google.com -> Security -> 2-Step Verification -> App passwords.
# Regular passwords are rejected over IMAP.
imap_password   = xxxxxxxxxxxxxxxx

imap_folder     = INBOX

# Gmail label applied after a label is filed, so you can see what the
# service has touched. Leave blank to skip.
processed_label = Shipped-Labels

# Where the database and label PDFs live.
home            = /home/pi/marketplace

# ---------------------------------------------------------------- printer
# The G4 has no Linux driver from Clabel (their portal ships Windows and
# Mac only), so we talk to it directly over the raw USB node. It speaks
# TSPL - confirmed by printing a real label - even though its IEEE-1284
# id claims COMMAND SET:ESC/POS. That id is boilerplate; the same string
# calls this thermal printer an "Impact Printer". If `mplabel probe`
# suggests escpos on this model, trust the label, not the id.
# Options: tspl, escpos, zpl, cups-pdf, cups-raster
printer_backend = tspl

# Raw USB node. Confirm with `mplabel.py probe`.
printer_device  = /dev/usb/lp0

# G4 is 203 dpi (8 dots/mm) -> a 4x6 label is exactly 812 x 1218 dots.
printer_dpi     = 203

# TSPL DENSITY, 0-15. 8 is a good start. Raise if barcodes scan faintly,
# lower if solid blacks bleed and smear. Ignored by the escpos backend:
# ESC/POS density is vendor-specific and the G4 documents no command for
# it, so set darkness on the unit itself.
printer_darkness = 8

# TSPL SPEED in inches/sec. The G4 tops out at 152 mm/s (~6 in/s), but
# slower gives crisper barcodes. 4 is a sensible default. TSPL only.
printer_speed   = 4

# How the printer finds the start of each label:
#   gap        die-cut labels with a gap between them  <- normal 4x6 stock
#   blackmark  stock with a black registration mark    (tspl only)
#   continuous gapless roll
# Getting this wrong is the usual cause of drifting or skipped labels.
media_tracking  = gap

# Gap size in inches. 0.12 (~3mm) suits most 4x6 die-cut stock. TSPL only:
# ESC/POS has no gap-distance command, the printer finds the gap itself
# when it is sent a form feed.
gap_inches      = 0.12

# escpos only. The label is sent as GS v 0 raster blocks of this many rows
# rather than one 1218-row block, because some firmwares reject an
# oversized raster command and then print nothing at all. Lower it if
# labels come out blank or truncated part-way down.
escpos_band_rows = 128

# A 3-digit code printed small in the top right of every label, so a stack
# of parcels can be told apart at a glance. It is stored on the sale and
# mirrored into the Sheet's Sales tab. Codes are picked at random from those
# not in use by a parcel that has yet to ship, and freed once it ships.
# The archived labels/<ref>_4x6.pdf is deliberately left unstamped - the
# stamp goes on a throwaway copy on its way to the printer, so a reprint
# cannot double-stamp.
label_code      = yes

# Point size of that code. Raise it if it is hard to read on thermal stock,
# lower it if it crowds anything on the label.
label_code_size = 8

# How many days back each poll looks. Read state is NOT used as a filter:
# Gmail marks every message in a conversation read when you open one, so
# nine orders threaded together would hide eight labels. The window plus
# the message-id check in the database is what stops repeats instead.
lookback_days   = 7

# Pause after each job. These firmwares drop bytes that arrive while the
# head is still moving, so do not set this to 0 if you print in batches.
settle_seconds  = 2.0

# Only used by the cups-* backends.
printer_queue   =

poll_seconds    = 120
auto_print      = yes

# ----------------------------------------------------------- google sheets
# Service account key file. Leave blank to disable the sync entirely.
# chmod 600 and own it by the service user - it is a credential.
sheets_key      = /etc/mplabel-sheets.json

# Identify the sheet by id (from its URL, the long string between /d/ and
# /edit) or by name. The id is safer - renaming the sheet will not break it.
sheets_id       =
sheets_name     = Marketplace

# Push after every poll that found something. The sync is wrapped so a
# Google outage can never stop a label printing.
sheets_after_poll = yes
