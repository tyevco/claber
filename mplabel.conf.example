# /etc/mplabel.conf   (chmod 600, owned by the user the service runs as)
#
# Tuned for a CLABEL G4 (Shenzhen Dudian), 203 dpi, USB.
#
# Any value can be overridden by an environment variable named
# MPLABEL_<KEY>, e.g. MPLABEL_IMAP_PASSWORD. That is the better place for
# the password if you would rather not have it on disk.

[mplabel]
imap_host       = imap.gmail.com
imap_port       = 993
imap_user       = her-address@gmail.com

# Gmail App Password, NOT the account password. Generate one at
# myaccount.google.com -> Security -> 2-Step Verification -> App passwords.
# Regular passwords are rejected over IMAP.
imap_password   = xxxxxxxxxxxxxxxx

imap_folder     = INBOX

# Gmail label applied after a label is filed, so you can see what the
# service has touched. Leave blank to skip.
processed_label = Shipped-Labels

# Where the database and label PDFs live.
home            = /home/pi/marketplace

# ---------------------------------------------------------------- printer
# The G4 has no Linux driver from Clabel (their portal ships Windows and
# Mac only), so we talk to it directly over the raw USB node. It speaks
# TSPL - confirmed by printing a real label - even though its IEEE-1284
# id claims COMMAND SET:ESC/POS. That id is boilerplate; the same string
# calls this thermal printer an "Impact Printer". If `mplabel probe`
# suggests escpos on this model, trust the label, not the id.
# Options: tspl, escpos, zpl, cups-pdf, cups-raster
printer_backend = tspl

# Raw USB node. Confirm with `mplabel.py probe`.
printer_device  = /dev/usb/lp0

# G4 is 203 dpi (8 dots/mm) -> a 4x6 label is exactly 812 x 1218 dots.
printer_dpi     = 203

# TSPL DENSITY, 0-15. 8 is a good start. Raise if barcodes scan faintly,
# lower if solid blacks bleed and smear. Ignored by the escpos backend:
# ESC/POS density is vendor-specific and the G4 documents no command for
# it, so set darkness on the unit itself.
printer_darkness = 8

# TSPL SPEED in inches/sec. The G4 tops out at 152 mm/s (~6 in/s), but
# slower gives crisper barcodes. 4 is a sensible default. TSPL only.
printer_speed   = 4

# How the printer finds the start of each label:
#   gap        die-cut labels with a gap between them  <- normal 4x6 stock
#   blackmark  stock with a black registration mark    (tspl only)
#   continuous gapless roll
# Getting this wrong is the usual cause of drifting or skipped labels.
media_tracking  = gap

# Gap size in inches. 0.12 (~3mm) suits most 4x6 die-cut stock. TSPL only:
# ESC/POS has no gap-distance command, the printer finds the gap itself
# when it is sent a form feed.
gap_inches      = 0.12

# escpos only. The label is sent as GS v 0 raster blocks of this many rows
# rather than one 1218-row block, because some firmwares reject an
# oversized raster command and then print nothing at all. Lower it if
# labels come out blank or truncated part-way down.
escpos_band_rows = 128

# The 48mm inventory label maker (SUPVAN / KATA Symbol T50M Pro). It is a
# vendor-defined HID device, not a USB printer, so it has no /dev/usb/lpN
# and this is a hidraw node. hidraw0 is only the usual number: another HID
# device plugged in first takes it and this one becomes hidraw1. The node
# is root-only until udev/99-supvan-t50m.rules is installed.
#
# Nothing prints to it - `mplabel inventory` writes a CSV for the vendor
# editor. `mplabel supvan-probe` polls its status, which moves no paper.
supvan_device   = /dev/hidraw0

# A short code printed small in the top right of every label, so a stack of
# parcels can be told apart at a glance. It is stored on the sale and
# mirrored into the Sheet's Sales tab.
#
# Three characters, picked at random from those not in use by a parcel that
# has yet to ship, and freed once it ships. The alphabet is digits and
# capitals minus I, L, O and U - the ones that get misread as 1, 1, 0 and V
# on thermal stock at arm's length.
#
# It is a handle, not just a marking: `mplabel reprint W7X` and
# `mplabel ship W7X` both take it, which is what makes reading it off a box
# worth doing.
#
# The archived labels/<ref>_4x6.pdf is deliberately left unstamped - the
# stamp goes on a throwaway copy on its way to the printer, so a reprint
# cannot double-stamp.
label_code      = yes

# Point size of that code. Raise it if it is hard to read on thermal stock,
# lower it if it crowds anything on the label.
label_code_size = 8

# How many days back each poll looks. Read state is NOT used as a filter:
# Gmail marks every message in a conversation read when you open one, so
# nine orders threaded together would hide eight labels. The window plus
# the message-id check in the database is what stops repeats instead.
lookback_days   = 7

# Pause after each job. These firmwares drop bytes that arrive while the
# head is still moving, so do not set this to 0 if you print in batches.
settle_seconds  = 2.0

# Only used by the cups-* backends.
printer_queue   =

poll_seconds    = 120
auto_print      = yes

# ----------------------------------------------------------- google sheets
# Service account key file. Leave blank to disable the sync entirely.
# chmod 600 and own it by the service user - it is a credential.
sheets_key      = /etc/mplabel-sheets.json

# Identify the sheet by id (from its URL, the long string between /d/ and
# /edit) or by name. The id is safer - renaming the sheet will not break it.
sheets_id       =
sheets_name     = Marketplace

# Push after every poll that found something. The sync is wrapped so a
# Google outage can never stop a label printing.
sheets_after_poll = yes

# ------------------------------------------------------------ print service
# `printd` is the print half of the split: it owns the printer and nothing
# else. Leave printer_backend as tspl to keep everything in one process -
# this is entirely optional, and rolling it back is one line.
#
# Do not switch to pi-http until the label geometry is signed off. Changing
# the transport while gap_inches is still unmeasured means a bad print you
# cannot attribute to either change.

# On the Pi that has the printer, run: mplabel printd
#
# printer_backend on THIS host must be a local one (tspl, zpl, escpos,
# cups-*). pi-http here would make printd print to itself: the inner
# request finds the gate held, burns the deadline and answers 410,
# which reads exactly like a busy printer. printd refuses to start
# rather than let that happen. pi-http belongs on the orders host.
printd_bind     = 127.0.0.1
printd_port     = 9101

# Both sides need the SAME secret. printd refuses to start without one
# rather than accept unsigned jobs - a print request is a physical action.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Both /print and /printed are signed with it. /healthz is not - it is
# the triage endpoint and has to answer when everything else is
# wrong, so it says nothing about any order.
printd_secret   =

# Spool and the done journal. Defaults to <home>/printd.
printd_state_dir =

# On the side that has the orders. Setting printer_backend = pi-http sends
# jobs here instead of to a device; every printer_* key below then belongs
# to the printd host, not to this one.
printd_url      =
printd_timeout  = 45

# The label maker has its own backend, because it is a second device and
# one may be local while the other is not. `supvan` drives /dev/hidraw0
# here; `pi-http` sends the tag spec to printd_url instead.
tag_backend     = supvan

# Longer than printd_timeout on purpose: that deadline only bounds
# *getting* the device, and the tag sequence polls the printer between
# every step, so the socket has to outlast the print itself.
printd_tag_timeout = 90

# The roll in the label maker, on the machine that has it. A tag spec
# carries neither unless the operator typed --size or --density, so an
# override is a deliberate one-shot and the default answer comes from
# whichever host can actually see the paper.
supvan_label_mm = 48x30
supvan_density  = 4

# Dots across the print head. render_bitmap refuses to render wider - the
# overflow is clipped by the hardware and ejects a second, blank label.
printer_head_dots = 812
